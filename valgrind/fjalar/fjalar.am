## Fjalar's changes to the Memcheck build.  Makefile.am, which includes
## this file at its end, is generated from ../memcheck/Makefile.am by
## generate-fjalar-makefile.sh; see its header comment.

#Fjalar has no 'tests' subdir
SUBDIRS = .

# PG - Build Fjalar with Kvasir (in the kvasir sub-directory)

## Build Fjalar at a higher optimisation level
# PG - don't do optimizations for the sake of debugging, instead add debugging info.
# Also disable the -Wmissing-prototypes warnings to prevent extra annoyances

#AM_CFLAGS_X86_LINUX   += -g -O0 -fno-omit-frame-pointer -Iinclude -W -Wall
#AM_CFLAGS_X86_LINUX   := $(AM_CFLAGS_X86_LINUX: -O2=-O0) -g -O0 -fno-omit-frame-pointer -Iinclude -W -Wall -Wno-format -Wno-format-zero-length -Wno-pointer-sign -Wno-long-long

# AM_CFLAGS_AMD64_LINUX += -g -O0 -fno-omit-frame-pointer -Iinclude -W -Wall

# get all binutil .h files from include; get config.h from .. (markro)
EXTRA_CFLAGS =  -Iinclude -I../VEX/pub -I../include -I..

# binutils-shim holds Fjalar's replacements for some Binutils headers, so it
# precedes include.  It also holds replacements for some C library headers,
# such as assert.h, that suit only code that runs in the tool, so the
# preload library does not use it.
#
# elfcomm.c defines a global error function, and so does Valgrind's core, in
# coregrind/m_gdbserver/utils.c, so -D renames the one in elfcomm.c.  The
# core defines no warn, so elfcomm.c's warn keeps its name.  A macro in a
# header would rename error only in the files that include that header
# before elfcomm.h; a file that declared error without seeing the macro
# would compile, link, and silently call the core's error.
BINUTILS_SHIM_CFLAGS = -Ibinutils-shim -Derror=fjalar_binutils_error

# for debugging versions
#EXTRA_CFLAGS +=  -O0 -finstrument-functions
EXTRA_CFLAGS +=  -O0

# Compile fjalar without -Wcast-qual
CFLAGS   += -Wno-cast-qual
CXXFLAGS += -Wno-cast-qual

# Compile fjalar without --fno-common (gcc version 10 default)
CFLAGS   += -fcommon
CXXFLAGS += -fcommon

# Fjalar's sources, in addition to the Memcheck sources.
FJALAR_SOURCES_COMMON += \
	fjalar_dwarf.c \
	fjalar_main.c \
	fjalar_runtime.c \
	fjalar_select.c \
	generate_fjalar_entries.c \
	GenericHashtable.c \
	fjalar_traversal.c \
	readelf.c \
	dwarf.c \
	libiberty/dwarfnames.c \
	elfcomm.c \
	typedata.c \
	disambig.c \
	my_libc.c \
	my_libc_float.c \
	tsearch.c \
	kvasir/kvasir_main.c \
	kvasir/decls-output.c \
	kvasir/dtrace-output.c \
	kvasir/union_find.c \
	kvasir/dyncomp_main.c \
	kvasir/dyncomp_runtime.c \
	kvasir/dyncomp_translate.c

VGPRELOAD_FJALAR_SOURCES_COMMON += kvasir/dyncomp_wrappers.c

# The -O0 in EXTRA_CFLAGS overrides the -O2 or -O earlier in these flags.
fjalar_@VGCONF_ARCH_PRI@_@VGCONF_OS@_CFLAGS += $(BINUTILS_SHIM_CFLAGS) $(EXTRA_CFLAGS)
vgpreload_fjalar_@VGCONF_ARCH_PRI@_@VGCONF_OS@_so_CFLAGS += $(EXTRA_CFLAGS)
if VGCONF_HAVE_PLATFORM_SEC
fjalar_@VGCONF_ARCH_SEC@_@VGCONF_OS@_CFLAGS += $(BINUTILS_SHIM_CFLAGS) $(EXTRA_CFLAGS)
vgpreload_fjalar_@VGCONF_ARCH_SEC@_@VGCONF_OS@_so_CFLAGS += $(EXTRA_CFLAGS)
endif

# The copies of Binutils files print unsigned values with signed formats and
# vice versa.  binutils-shim/sysdep.h cannot disable -Wformat-signedness for
# them, because GCC's pragma cannot, so disable it for their object files.
# These are GNU make target-specific variables.  They append to the
# per-program variable, not to CFLAGS, so that a CFLAGS given on the make
# command line does not discard the option.  They add the option only if
# configure found that the compiler supports -Wformat-signedness.
fjalar_@VGCONF_ARCH_PRI@_@VGCONF_OS@-readelf.$(OBJEXT) \
fjalar_@VGCONF_ARCH_PRI@_@VGCONF_OS@-dwarf.$(OBJEXT) \
fjalar_@VGCONF_ARCH_PRI@_@VGCONF_OS@-elfcomm.$(OBJEXT): \
	fjalar_@VGCONF_ARCH_PRI@_@VGCONF_OS@_CFLAGS += \
	$(if $(FLAG_W_FORMAT_SIGNEDNESS),-Wno-format-signedness)
if VGCONF_HAVE_PLATFORM_SEC
fjalar_@VGCONF_ARCH_SEC@_@VGCONF_OS@-readelf.$(OBJEXT) \
fjalar_@VGCONF_ARCH_SEC@_@VGCONF_OS@-dwarf.$(OBJEXT) \
fjalar_@VGCONF_ARCH_SEC@_@VGCONF_OS@-elfcomm.$(OBJEXT): \
	fjalar_@VGCONF_ARCH_SEC@_@VGCONF_OS@_CFLAGS += \
	$(if $(FLAG_W_FORMAT_SIGNEDNESS),-Wno-format-signedness)
endif


#----------------------------------------------------------------------------
# Consistency check for fjalar_core_decls.h
#----------------------------------------------------------------------------

# fjalar_core_decls.h copies declarations from coregrind headers, which
# tool files must not include.  Compile it together with those headers, so
# that the build fails if a Valgrind merge makes the copies wrong.  The
# test program is piped to the compiler rather than stored in a .c file,
# because tests/check_headers_and_includes forbids tool .c files from
# including pub_core headers.  Each fjalar program depends on the stamp,
# so the check runs whenever a program is built.
MOSTLYCLEANFILES = fjalar_core_decls.stamp

fjalar_@VGCONF_ARCH_PRI@_@VGCONF_OS@_DEPENDENCIES += fjalar_core_decls.stamp
if VGCONF_HAVE_PLATFORM_SEC
fjalar_@VGCONF_ARCH_SEC@_@VGCONF_OS@_DEPENDENCIES += fjalar_core_decls.stamp
endif

fjalar_core_decls.stamp: $(srcdir)/fjalar_core_decls.h \
		$(top_srcdir)/coregrind/pub_core_aspacemgr.h \
		$(top_srcdir)/coregrind/pub_core_libcfile.h \
		$(top_srcdir)/coregrind/pub_core_machine.h \
		$(top_srcdir)/coregrind/pub_core_mallocfree.h \
		$(top_srcdir)/coregrind/pub_core_syscall.h
	{ echo '#include "fjalar_core_decls.h"'; \
	  echo 'enum { fjalar_ar_demangle = VG_AR_DEMANGLE };'; \
	  echo '#undef VG_AR_DEMANGLE'; \
	  echo '#include "pub_core_aspacemgr.h"'; \
	  echo '#include "pub_core_vki.h"'; \
	  echo '#include "pub_core_libcfile.h"'; \
	  echo '#include "pub_core_machine.h"'; \
	  echo '#include "pub_core_mallocfree.h"'; \
	  echo '#include "pub_core_syscall.h"'; \
	  echo '_Static_assert(fjalar_ar_demangle == VG_AR_DEMANGLE,'; \
	  echo '  "VG_AR_DEMANGLE in fjalar_core_decls.h is wrong");'; \
	} | $(CC) $(fjalar_@VGCONF_ARCH_PRI@_@VGCONF_OS@_CPPFLAGS) \
	    $(fjalar_@VGCONF_ARCH_PRI@_@VGCONF_OS@_CFLAGS) \
	    -I$(srcdir) -I$(top_srcdir)/coregrind -fsyntax-only -x c -
	touch $@
