# Ignore temp files generated by editors and other tools
*~

# Ignore files generated by hg revert and similar backup files
*.bak
*.log
*.new
*.old
*.orig
*.sav

# Ignore files generated by Autotools.  valgrind/.gitignore, which is
# upstream Valgrind's, lists the files that Valgrind's build generates.
Makefile
Makefile*.in
.deps
.dirstamp
valgrind/confdefs.h
valgrind/conftest.c
valgrind/conftest.err

valgrind/include/vgversion_dist.h

# Ignore files generated during document generation
valgrind/fjalar/notes/design-doc/fjalar.log
valgrind/fjalar/notes/design-doc/fjalar.pdf

# Ignore generated assembly, object and shared library files
*.a
*.o
*.so

valgrind-di-server
valgrind-listener
*-x86-linux
*-amd64-linux

# Ignore the output and diffs that vg_regtest leaves behind for each failing
# test (it deletes them for passing tests).  check-regtest.sh reports the
# failing tests, and CI saves these files.
valgrind/**/*.out
valgrind/**/*.diff*

# Ignore output of check-regtest.sh (the log is covered by *.log)
/regtest-*-observed.txt

# Ignore generated and installed valgrind tools
valgrind/inst

# Ignore Doxygen input/output files
valgrind/fjalar/doxy.config
valgrind/fjalar/html
valgrind/fjalar/rundoxy

# Ignore shell scripts for compiling fjalar
valgrind/fjalar/*.sh

# Stamp file for the fjalar_core_decls.h consistency check
valgrind/fjalar/fjalar_core_decls.stamp

# Documentation
valgrind-merge.aux
valgrind-merge.cp
valgrind-merge.cps
valgrind-merge.fn
valgrind-merge.fns
valgrind-merge.html
valgrind-merge.info
valgrind-merge.ky
valgrind-merge.log
valgrind-merge.pdf
valgrind-merge.pg
valgrind-merge.toc
valgrind-merge.tp
valgrind-merge.vr
